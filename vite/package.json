{
  "name": "brackeys-16-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen": "node ../tools/gen-contract.mjs",
    "gen:check": "node ../tools/gen-contract.mjs --check",
    "dev": "vite",
    "dev:full": "npm run build:godot && vite",
    "editor": "godot --editor --path ../godot",
    "test:godot": "godot --headless --path ../godot -s res://addons/gdUnit4/bin/GdUnitCmdTool.gd --ignoreHeadlessMode -a res://tests",
    "build:godot": "godot --headless --path ../godot --import && godot --headless --path ../godot --export-release \"Web\" ../vite/public/godot/index.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
